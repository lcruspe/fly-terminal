@@ -0,0 +1,20 @@
+package cidata
+
+import (
+	"github.com/lima-vm/lima/v2/pkg/limatype"
+	"testing"
+)
+
+func TestDiskDeviceNameFromOrder(t *testing.T) {
+	for _, tc := range []struct {
+		vm    limatype.VMType
+		order int
+		want  string
+	}{
+		{"krunkit", 0, "vdc"}, {"krunkit", 1, "vdd"}, {limatype.VZ, 0, "vdb"}, {limatype.QEMU, 0, "vdb"},
+	} {
+		if got := diskDeviceNameFromOrder(tc.order, tc.vm); got != tc.want {
+			t.Errorf("%s disk %d = %s; want %s", tc.vm, tc.order, got, tc.want)
+		}
+	}
+}
