diff --git a/environment/vm/lima/docker-disk-guard.sh b/environment/vm/lima/docker-disk-guard.sh
new file mode 100644
index 0000000..912df74
--- /dev/null
+++ b/environment/vm/lima/docker-disk-guard.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env sh
+set -eu
+# Stop socket activation and both services before mounting runtime storage.
+systemctl stop docker.socket docker.service containerd.service
+install -d /usr/local/sbin
+cat > /usr/local/sbin/colima-check-runtime-disk <<'GUARD'
+#!/usr/bin/env sh
+set -eu
+case "$1" in docker|containerd) ;; *) exit 2 ;; esac
+label="lima-{{ .InstanceId }}"
+root="/mnt/$label"
+# Check the exact mount point, the disk identity and the bound subdirectory.
+test "$(findmnt -n --mountpoint "$root" --source "LABEL=$label" -o FSROOT)" = /
+test "$(findmnt -n --mountpoint "/var/lib/$1" --source "LABEL=$label" -o FSROOT)" = "/$1"
+GUARD
+chmod 0755 /usr/local/sbin/colima-check-runtime-disk
+for service in docker containerd; do
+    directory="/etc/systemd/system/$service.service.d"
+    install -d "$directory"
+    printf '[Service]\nExecStartPre=/usr/local/sbin/colima-check-runtime-disk %s\n' "$service" > "$directory/colima-data-disk.conf"
+done
+systemctl daemon-reload
diff --git a/environment/vm/lima/docker-disk-stop.sh b/environment/vm/lima/docker-disk-stop.sh
new file mode 100644
index 0000000..346b06c
--- /dev/null
+++ b/environment/vm/lima/docker-disk-stop.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env sh
+set -eu
+label="lima-{{ .InstanceId }}"
+root="/mnt/$label"
+systemctl stop docker.socket docker.service containerd.service
+sync
+for name in ramalama cni rancher containerd docker; do
+    path="/var/lib/$name"
+    if findmnt -n --mountpoint "$path" >/dev/null; then
+        test "$(findmnt -n --mountpoint "$path" --source "LABEL=$label" -o FSROOT)" = "/$name"
+        umount "$path"
+    fi
+done
+if findmnt -n --mountpoint "$root" >/dev/null; then
+    test "$(findmnt -n --mountpoint "$root" --source "LABEL=$label" -o FSROOT)" = /
+    umount "$root"
+fi
+sync
+echo "Krunkit persistent Docker disk cleanly detached"
