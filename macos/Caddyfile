{
	auto_https off
	admin off
}

# Порт по умолчанию: только защищённый каталог доступных сервисов.
:{$CADDY_PORT:8080} {
	root * {$FLY_TERMINAL_REPO_ROOT}/macos/gateway

	# The legacy Tailscale IP/HTTP entry must use HTTPS to persist Secure session cookies.
	@legacyTailGateway host 100.125.224.119
	redir @legacyTailGateway https://mac-gateway.tail1c55c5.ts.net{uri} 308

	@ytIcon path /yt-transcriber/apple-touch-icon.png
	@ytLogin path /yt-login
	@gatewayStatus path /gateway-status
	@ytUi path /yt-transcriber /yt-transcriber/*
	@roomaudioRoot path /roomaudio
	# Mate can switch Wi-Fi subnets. Permit source ingest and polling over the
	# Oracle HTTPS relay: server.py checks X-Ingest-Key for every such request.
	# Installation/setup endpoints remain unavailable through the public relay.
	@roomAudioPrivate path /roomaudio/setup/*
	handle @roomAudioPrivate {
		respond "Not found" 404
	}
	# RoomAudio authenticates requests with its own Basic Auth realm.
	@gatewayProtected not path /roomaudio /roomaudio/* /yt-transcriber /yt-transcriber/* /yt-login /yt-transcriber/apple-touch-icon.png

	basic_auth @gatewayProtected {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
		{$CADDY_SPRUTHUB_AUTH_USER} {$CADDY_SPRUTHUB_AUTH_HASH}
	}

	@assets path /gateway.css /gateway.js
	@gatewayUi path / /admin.html /gateway.js /gateway.css
	header @gatewayUi {
		Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Pragma "no-cache"
		Expires "0"
	}
	@spruthubUser expression `{http.auth.user.id} == "{$CADDY_SPRUTHUB_AUTH_USER}"`

	handle @ytIcon {
		uri strip_prefix /yt-transcriber
		reverse_proxy 127.0.0.1:8787
	}

	handle @ytLogin {
		basic_auth {
			{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
			{$CADDY_SPRUTHUB_AUTH_USER} {$CADDY_SPRUTHUB_AUTH_HASH}
		}
		rewrite * /session/bootstrap
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Authenticated-User {http.auth.user.id}
			header_up X-YT-Bootstrap-Secret {$YT_BOOTSTRAP_SECRET}
		}
	}

	handle @ytUi {
		uri strip_prefix /yt-transcriber
		reverse_proxy 127.0.0.1:8787
	}

	# Service controls are available only to the primary administrator.
	handle /gateway-control/* {
		@gatewayControlDenied expression `{http.auth.user.id} != "{$CADDY_BASIC_AUTH_USER}"`
		respond @gatewayControlDenied "Forbidden" 403
		reverse_proxy 127.0.0.1:{$FLY_GATEWAY_CONTROL_PORT:7684}
	}

	handle @gatewayStatus {
		rewrite * /api/gateway/status
		reverse_proxy 127.0.0.1:{$FLY_TERMINAL_CONTROL_PORT:7683}
	}

	redir @roomaudioRoot /roomaudio/ 302
	handle_path /roomaudio/* {
		reverse_proxy {$FLY_ROOMAUDIO_UPSTREAM:http://127.0.0.1:8766} {
			# Forward RoomAudio's Authorization header, not Fly Terminal's.
			header_up X-Forwarded-Prefix /roomaudio
		}
	}

	handle @assets {
		file_server
	}

	handle @spruthubUser {
		rewrite * /spruthub.html
		file_server
	}

	handle {
		rewrite * /admin.html
		file_server
	}
}

# Порт 8443: прямой доступ к Fly Terminal.
:{$CADDY_TERMINAL_PORT:8081} {
	root * {$FLY_TERMINAL_REPO_ROOT}

	basic_auth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}

	@terminalRoot path /terminal
	@terminal path /terminal/*
	@api path /api/*
	@browserRoot path /browser
	@browser path /browser/*
	@browserWebsocket path /browser/websockets* /websockify*
	@desktopRoot path /desktop
	@desktop path /desktop/*
	@desktopWs path /desktop-ws /desktop-ws/*
	@desktopStreamWs path /desktop-stream-ws /desktop-stream-ws/*
	@nativeBrowserStreamWs path /native-browser-stream-ws /native-browser-stream-ws/*
	@desktopWebRtcApi path /desktop-webrtc-api /desktop-webrtc-api/*
	@nativeBrowserWebRtcApi path /native-browser-webrtc-api /native-browser-webrtc-api/*
	@desktopStreamApi path /api/desktop/stream/*
	@selkiesWs path /ws /data /health /metrics /signaling /webrtc /audio /video
	@volatileUi path / /index.html /desktop/webrtc.html /desktop/vnc.html
	header @volatileUi {
		Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Pragma "no-cache"
		Expires "0"
	}

	route {
		redir @terminalRoot /terminal/ 302
		reverse_proxy @terminal 127.0.0.1:{$TTYD_PORT:7682}
		reverse_proxy @api 127.0.0.1:{$FLY_TERMINAL_CONTROL_PORT:7683}
		redir @browserRoot /browser/ 302
		redir @desktopRoot /desktop/ 302

		handle @desktopStreamWs {
			uri strip_prefix /desktop-stream-ws
			reverse_proxy 127.0.0.1:{$FLY_STREAMER_PORT:5905}
		}
		handle @nativeBrowserStreamWs {
			uri strip_prefix /native-browser-stream-ws
			reverse_proxy 127.0.0.1:{$FLY_NATIVE_BROWSER_STREAMER_PORT:5906}
		}
		handle @desktopWebRtcApi {
			uri strip_prefix /desktop-webrtc-api
			reverse_proxy 127.0.0.1:{$FLY_WEBRTC_PORT:5907}
		}
		handle @nativeBrowserWebRtcApi {
			uri strip_prefix /native-browser-webrtc-api
			reverse_proxy 127.0.0.1:{$FLY_NATIVE_BROWSER_WEBRTC_PORT:5908}
		}
		handle @desktopStreamApi {
			uri strip_prefix /api/desktop/stream
			reverse_proxy 127.0.0.1:{$FLY_STREAMER_PORT:5905}
		}
		handle @desktopWs {
			uri strip_prefix /desktop-ws
			reverse_proxy 127.0.0.1:{$FLY_DESKTOP_PORT:5901}
		}
		handle @desktop {
			uri strip_prefix /desktop
			root * {$FLY_TERMINAL_REPO_ROOT}/vendor/novnc
			file_server
		}

		handle @browserWebsocket {
			uri strip_prefix /browser
			reverse_proxy {$FLY_BROWSER_UPSTREAM:http://127.0.0.1:7690} {
				header_up Authorization "Basic {$FLY_BROWSER_BASIC_AUTH}"
				header_down -Cross-Origin-Embedder-Policy
				header_down -Cross-Origin-Opener-Policy
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
			}
		}
		handle @selkiesWs {
			reverse_proxy {$FLY_BROWSER_UPSTREAM:http://127.0.0.1:7690} {
				header_up Authorization "Basic {$FLY_BROWSER_BASIC_AUTH}"
				header_down -Cross-Origin-Embedder-Policy
				header_down -Cross-Origin-Opener-Policy
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
			}
		}
		handle @browser {
			uri strip_prefix /browser
			reverse_proxy {$FLY_BROWSER_UPSTREAM:http://127.0.0.1:7690} {
				header_up Authorization "Basic {$FLY_BROWSER_BASIC_AUTH}"
				header_down -Cross-Origin-Embedder-Policy
				header_down -Cross-Origin-Opener-Policy
				header_down -X-Frame-Options
				header_down -Content-Security-Policy
			}
		}

		try_files {path} /index.html
		file_server
	}
}

# Порт 10000: прямой защищённый доступ к Sprut.Hub.
:{$CADDY_SPRUTHUB_PORT:8082} {
	basic_auth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
		{$CADDY_SPRUTHUB_AUTH_USER} {$CADDY_SPRUTHUB_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:{$FLY_SPRUTHUB_FORWARD_PORT:7693} {
		header_up -Authorization
		header_up Host {$FLY_SPRUTHUB_TARGET_HOST:192.168.1.100}
	}
}
